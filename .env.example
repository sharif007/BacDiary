PORT=3000
# Long random string — keeps admins logged in across restarts
SESSION_SECRET=change-me-to-a-long-random-string
# First admin account (only used when the database is empty)
ADMIN_USER=admin
ADMIN_PASS=change-me
# Set to 1 when the site is served over HTTPS
COOKIE_SECURE=0
# Where the database and generated Word files are stored
# DATA_DIR=./data
